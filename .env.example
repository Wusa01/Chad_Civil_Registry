# انسخ هذا الملف إلى .env واملأ القيم الحقيقية (.env لا يُرفع على GitHub)

SECRET_KEY=غيّر-هذا-المفتاح-إلى-قيمة-عشوائية-طويلة
DATABASE_URL=sqlite:///civil_registry.db

# ── إعدادات البريد الإلكتروني (لاستعادة كلمة المرور) ──
# مثال باستخدام Gmail SMTP:
# 1) فعّل "التحقق بخطوتين" على حساب Gmail المُرسِل
# 2) أنشئ "App Password" من: https://myaccount.google.com/apppasswords
# 3) استخدم كلمة مرور التطبيق (16 حرفاً) هنا، وليس كلمة مرور Gmail العادية
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-address@gmail.com
MAIL_PASSWORD=your-16-char-app-password
MAIL_DEFAULT_SENDER=your-address@gmail.com
